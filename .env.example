# Environment variables for LogApart Docker Compose deployment.
# Copy this file to .env before running `docker compose up -d --build`.

# MySQL Root and Application User Passwords
DB_ROOT_PASSWORD=change_this_to_a_secure_root_password
DB_NAME=logapart
DB_USER=logapart
DB_PASSWORD=change_this_to_a_secure_password

# Authentication (must be at least 24 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_random_48_byte_hex_string_at_least_24_chars

# Public URL of the frontend (CORS origin allowed by backend; cannot be localhost in production)
# e.g., https://logapart.yourdomain.com
CORS_ORIGIN=https://logapart.yourdomain.com

# Public URL of the backend API (baked into frontend at build time)
# e.g., https://api.logapart.yourdomain.com
VITE_API_URL=https://api.logapart.yourdomain.com

# Logging
LOG_LEVEL=info
