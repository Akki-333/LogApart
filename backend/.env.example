# Set to production on a real deployment. That makes DB_HOST, DB_USER,
# DB_PASSWORD and CORS_ORIGIN mandatory, and refuses a localhost origin.
NODE_ENV=development

PORT=5000

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=apartment_admin

# Auth. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# How long npm run db:retention keeps personal data, in days.
# Gate records, the address on an activity entry, and sign-in attempts.
GATE_LOG_RETENTION_DAYS=365
AUDIT_IP_RETENTION_DAYS=180
LOGIN_ATTEMPT_RETENTION_DAYS=30
